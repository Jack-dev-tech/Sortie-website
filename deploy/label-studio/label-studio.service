[Unit]
Description=Sortie Label Studio annotation server
After=network.target

[Service]
Type=simple
User=labelstudio
Group=labelstudio
WorkingDirectory=/var/lib/label-studio
EnvironmentFile=/etc/sortie/label-studio.env
Environment=HOME=/var/lib/label-studio
ExecStart=/opt/label-studio/venv/bin/label-studio start --no-browser --internal-host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/label-studio

[Install]
WantedBy=multi-user.target

# Replace both addresses with the HTTPS URL printed by tailscale serve.
LABEL_STUDIO_HOST=https://sortie.YOUR-TAILNET.ts.net
CSRF_TRUSTED_ORIGINS=https://sortie.YOUR-TAILNET.ts.net
LABEL_STUDIO_BASE_DATA_DIR=/var/lib/label-studio
LABEL_STUDIO_DATABASE=/var/lib/label-studio/label_studio.sqlite3
DISABLE_SIGNUP_WITHOUT_LINK=true
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
